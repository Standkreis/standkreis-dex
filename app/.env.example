# standkreis-dex — the app's environment (handoff 0010 Track B). Copy to app/.env for dev; deploy/.env holds production.
# In production (NODE_ENV=production, `next start` or the image's `node server.js`) every variable below is REQUIRED and
# the server refuses to start naming what is missing (src/server/env.ts). In dev the values shown are the defaults.

# Postgres. Dev: the docker-compose DB on 5433. Production: the Compose `db` service.
DATABASE_URL=postgresql://dex:dex@localhost:5433/dex

# Passkeys are bound to this domain forever (the relying-party id): the apex, never a subdomain that might move.
# Dev: localhost on any port. Production: WEBAUTHN_RP_ID=standkreis.<tld>, WEBAUTHN_ORIGIN=https://standkreis.<tld>
# WEBAUTHN_ORIGIN may list several origins, comma-separated; unset in dev means "trust the request's localhost origin".
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=

# Signs the passkey challenge cookie and the delete token (HMAC-SHA256). Production: `openssl rand -hex 32`, at least
# 32 characters, never the dev value. Rotating it only invalidates challenges and delete tokens in flight, not passkeys.
WEBAUTHN_SECRET=dev-only-secret-set-WEBAUTHN_SECRET-in-production

# User photos on disk, one <assetId>.jpg per upload. Dev: app/data/photos. Production: the `photos` volume, /data/photos.
PHOTO_DIR=./data/photos

# Static export only (STATIC_EXPORT=1, the Capacitor shell): the origin the client talks to for /api/*. Empty on the server.
NEXT_PUBLIC_API_URL=

# ETL (etl/README.md): per-host request budget per run and the GBIF occurrence window. Laptop only, the VM runs no ETL.
ETL_BUDGET=50000
ETL_YEARS=2016,2026
